{
  "name": "abap-mirror",
  "displayName": "ABAP Mirror",
  "description": "Mirrors SAP ADT (abap://) documents to real files so AI coding assistants like Claude Code can read and edit them, with every change staying under your review.",
  "version": "0.2.1",
  "publisher": "abgunes",
  "license": "MIT",
  "scripts": {
    "compile": "tsc",
    "watch": "tsc -w",
    "vscode:prepublish": "npm run compile",
    "pretest": "npm run compile",
    "test": "node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abgunes/ABAP-Mirror"
  },
  "homepage": "https://github.com/abgunes/ABAP-Mirror",
  "bugs": {
    "url": "https://github.com/abgunes/ABAP-Mirror/issues"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "icon": "images/icon.png",
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "abap",
    "adt",
    "sap",
    "claude",
    "claude code",
    "mirror"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "ABAP Mirror",
      "properties": {
        "abapMirror.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Mirror active abap:// ADT documents to real files (and sync edits back) so Claude Code can read/edit them. Toggle off to fully disable, no reload needed."
        },
        "abapMirror.icons.enableInMirrorPanel": {
          "type": "boolean",
          "default": true,
          "description": "Show a colored icon for each object's ABAP type (class, CDS view, table, ...) in the ABAP Mirror Files panel."
        },
        "abapMirror.typeIcons": {
          "type": "array",
          "maxItems": 100,
          "description": "The abbreviation and color shown for each ABAP object type in the ABAP Mirror Files panel. Edit via the \"ABAP Mirror - Configure Type Icons\" command, or directly here.",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,20}$", "description": "ABAP object type code, e.g. CLAS, DDLS, TABL. UNKNOWN is the fallback for anything unrecognized." },
              "abbreviation": { "type": "string", "maxLength": 2, "pattern": "^[A-Za-z0-9]{1,2}$", "description": "1-2 letter label shown on the icon." },
              "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "description": "Hex color for the icon background, e.g. #2ea043." }
            },
            "required": ["type", "abbreviation", "color"]
          },
          "default": [
            { "type": "CLAS", "abbreviation": "CL", "color": "#2ea043" },
            { "type": "INTF", "abbreviation": "IN", "color": "#2ea043" },
            { "type": "DDLS", "abbreviation": "D", "color": "#2f81f7" },
            { "type": "DDLX", "abbreviation": "MX", "color": "#2f81f7" },
            { "type": "DCLS", "abbreviation": "AC", "color": "#2f81f7" },
            { "type": "SRVD", "abbreviation": "SD", "color": "#2f81f7" },
            { "type": "BDEF", "abbreviation": "BD", "color": "#8957e5" },
            { "type": "SRVB", "abbreviation": "SB", "color": "#8957e5" },
            { "type": "TABL", "abbreviation": "TB", "color": "#c9a227" },
            { "type": "STRU", "abbreviation": "ST", "color": "#c9a227" },
            { "type": "TTYP", "abbreviation": "TT", "color": "#c9a227" },
            { "type": "DTEL", "abbreviation": "DE", "color": "#c9a227" },
            { "type": "DOMA", "abbreviation": "DO", "color": "#c9a227" },
            { "type": "PROG", "abbreviation": "P", "color": "#a1682a" },
            { "type": "FUGR", "abbreviation": "FG", "color": "#a1682a" },
            { "type": "INCL", "abbreviation": "I", "color": "#a1682a" },
            { "type": "FUNC", "abbreviation": "FM", "color": "#a1682a" },
            { "type": "UNKNOWN", "abbreviation": "?", "color": "#6e7681" }
          ]
        },
        "abapMirror.mcp.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "Run the local `abap-mirror` MCP server so external AI tools (Cursor, Copilot, Cline, Claude Code, ...) can list, search, read, write, activate, lock and unlock ABAP objects through the SAP ADT connection open in VS Code. Listens on 127.0.0.1 only and needs a token; use **ABAP Mirror - Copy MCP Client Config** to connect a client."
        },
        "abapMirror.mcp.port": {
          "type": "integer",
          "default": 2240,
          "minimum": 1024,
          "maximum": 65535,
          "scope": "application",
          "description": "Local port for the abap-mirror MCP server (127.0.0.1 only)."
        },
        "abapMirror.mcp.confirmWrites": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Ask in VS Code before an MCP client saves, activates, locks or unlocks an ABAP object. Saving through MCP writes to the SAP system, so only turn this off if you trust the client completely."
        },
        "abapMirror.mcp.indexedPackagePrefixes": {
          "type": "array",
          "default": ["Z", "Y"],
          "maxItems": 50,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_$/]{1,30}$"
          },
          "description": "Top-level packages whose names start with one of these prefixes are crawled when the MCP object index is rebuilt. Objects outside them are still found through the interactive Open Object search."
        }
      }
    },
    "commands": [
      {
        "command": "abapMirror.open",
        "title": "ABAP Mirror - Open Mirror Object"
      },
      {
        "command": "abapMirror.folder",
        "title": "ABAP Mirror - Mirror Folder (with Sub-Objects)"
      },
      {
        "command": "abapMirror.configureTypeIcons",
        "title": "ABAP Mirror - Configure Type Icons",
        "icon": "$(gear)"
      },
      {
        "command": "abapMirror.retrySyncErrors",
        "title": "ABAP Mirror - Retry Failed Syncs",
        "icon": "$(sync)"
      },
      {
        "command": "abapMirror.retrySyncForItem",
        "title": "ABAP Mirror - Retry Sync",
        "icon": "$(sync)"
      },
      {
        "command": "abapMirror.retrySyncForFolder",
        "title": "ABAP Mirror - Retry Sync for Folder",
        "icon": "$(sync)"
      },
      {
        "command": "abapMirror.mcp.copyClientConfig",
        "title": "ABAP Mirror - Copy MCP Client Config"
      },
      {
        "command": "abapMirror.mcp.regenerateToken",
        "title": "ABAP Mirror - Regenerate MCP Token"
      },
      {
        "command": "abapMirror.mcp.rebuildIndex",
        "title": "ABAP Mirror - Rebuild MCP Object Index"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "abapMirror.open",
          "when": "resourceScheme == abap",
          "group": "z_abapMirror@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "abapMirror.open",
          "when": "resourceScheme == abap",
          "group": "z_abapMirror@1"
        }
      ],
      "explorer/context": [
        {
          "command": "abapMirror.folder",
          "when": "resourceScheme == abap && explorerResourceIsFolder",
          "group": "z_abapMirror@1"
        }
      ],
      "view/title": [
        {
          "command": "abapMirror.configureTypeIcons",
          "when": "view == abapMirror.files",
          "group": "navigation"
        },
        {
          "command": "abapMirror.retrySyncErrors",
          "when": "view == abapMirror.files",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "abapMirror.retrySyncForItem",
          "when": "view == abapMirror.files && viewItem == abapMirrorObjectUnsynced",
          "group": "inline"
        },
        {
          "command": "abapMirror.retrySyncForFolder",
          "when": "view == abapMirror.files && viewItem == abapMirrorFolderUnsynced",
          "group": "inline"
        }
      ]
    },
    "languages": [
      {
        "id": "abap-mirror-view",
        "extensions": [
          ".abapmirror"
        ],
        "aliases": [
          "ABAP (mirror view)"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "abap-mirror-view",
        "scopeName": "source.abapmirror",
        "path": "./syntaxes/abap-mirror.tmLanguage.json"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "abapMirror.files",
          "name": "ABAP Mirror Files"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/vscode": "1.82.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "@hono/node-server": "^1.19.9"
  }
}
